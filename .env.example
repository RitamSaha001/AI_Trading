# =============================================================================
# Lumen AI Trading - Environment Configuration Template
# =============================================================================
#
# SECURITY DIRECTIVES:
# 1. NEVER commit actual production secrets, API keys, or private keys to Git.
# 2. Production secrets must be injected securely via your cloud secret manager
#    (e.g., AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault, Doppler).
# 3. CRITICAL NOTE ON VITE_* VARIABLES:
#    Any variable prefixed with "VITE_" is embedded directly into the client-side
#    JavaScript bundle and is PUBLICLY VISIBLE to anyone inspecting web traffic.
# 4. SERVER SECRETS MUST NEVER USE THE "VITE_" PREFIX:
#    - ENCRYPTION_MASTER_KEY, SESSION_SECRET, BINANCE_API_SECRET,
#      PAYMENT_PROVIDER_SECRET, and PHONEPE_SALT_KEY are backend-only secrets.
#    - Do NOT prefix backend secrets with VITE_.
#    - Never expose Binance API credentials to the browser client.
#
# =============================================================================

# Server Environment Mode ('development' | 'staging' | 'production' | 'test')
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Local Development / Test: SQLite engine (in-memory or local file)
SQLITE_PATH=./lumen_trading.db

# Production: Canonical PostgreSQL is MANDATORY (Neon, Supabase, RDS, Cloud SQL)
# Must start with postgresql:// or postgres:// and CANNOT point to localhost in production.
# DATABASE_URL=postgresql://<username>:<password>@<db-host>:<port>/<database_name>?sslmode=require

# -----------------------------------------------------------------------------
# Cryptographic Server Secrets
# -----------------------------------------------------------------------------
# ENCRYPTION_MASTER_KEY: Exactly 32 bytes (64 hexadecimal characters) for AES-256-GCM.
# Generate via: openssl rand -hex 32
# Production refuses to start if this is missing, invalid length, non-hex, or known default.
ENCRYPTION_MASTER_KEY=<generate-64-hex-character-key-via-openssl-rand-hex-32>

# SESSION_SECRET: Unpredictable session signing secret (minimum 32 characters).
# Generate via: openssl rand -base64 32
# Production refuses to start if this contains 'mock', 'test', 'demo', or known repository defaults.
SESSION_SECRET=<generate-a-random-32-plus-character-secret>

# -----------------------------------------------------------------------------
# Social Identity & Authentication (Google & Apple)
# -----------------------------------------------------------------------------
# Backend verification audience IDs:
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
APPLE_CLIENT_ID=com.lumen.trading.client
APPLE_TEAM_ID=<your-apple-team-id>
APPLE_KEY_ID=<your-apple-key-id>

# -----------------------------------------------------------------------------
# Payment Gateways (PhonePe UPI / Netbanking / Cards)
# -----------------------------------------------------------------------------
# Provider options: 'phonepe' | 'razorpay' | 'stripe' | 'sandbox'
# Note: 'sandbox' is strictly prohibited in production mode.
PAYMENT_PROVIDER=sandbox

# Razorpay / Stripe (if applicable)
PAYMENT_PROVIDER_KEY=<your-payment-provider-public-key>
PAYMENT_PROVIDER_SECRET=<your-payment-provider-secret>
PAYMENT_WEBHOOK_SECRET=<generate-a-random-32-plus-character-secret>

# PhonePe Production Gateway (India UPI 0% MDR)
# Required in production if PAYMENT_PROVIDER=phonepe:
PHONEPE_MERCHANT_ID=<your-phonepe-merchant-id>
PHONEPE_SALT_KEY=<your-phonepe-salt-key>
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api.phonepe.com/apis/hermes
PHONEPE_CALLBACK_URL=https://your-domain.com/api/webhooks/phonepe

# -----------------------------------------------------------------------------
# Binance Exchange Execution Gateway
# -----------------------------------------------------------------------------
# Environment options: 'testnet' | 'mainnet'
# If live trading is enabled in production, BINANCE_ENV must be 'mainnet'.
BINANCE_ENV=testnet
BINANCE_API_KEY=<your-binance-api-key>
BINANCE_API_SECRET=<your-binance-api-secret>

# -----------------------------------------------------------------------------
# AI Market Analysis
# -----------------------------------------------------------------------------
# Google Gemini API Key (Server-side)
GEMINI_API_KEY=<your-gemini-api-key>

# -----------------------------------------------------------------------------
# Web3 / EVM Blockchain RPCs
# -----------------------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# =============================================================================
# Frontend Client Public Variables (Vite Bundle)
# WARNING: These are bundled into public client JS. NEVER put secrets here!
# =============================================================================
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.lumen.trading.client
VITE_GEMINI_API_KEY=<your-optional-public-gemini-key>
