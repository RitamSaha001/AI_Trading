# =============================================================================
# Lumen AI Trading - Zero-Cost Production & Staging Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration (100% Free Options Available)
# Option A (Default): In-memory or local file SQLite (Zero cost, built-in)
SQLITE_PATH=./lumen_trading.db
# Option B (Production): Supabase or Neon Free Tier PostgreSQL ($0/mo)
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Cryptographic Secrets
# Generate 64-hex char string via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=lumen_enterprise_super_secret_session_key_min_32_characters_long_2026

# -----------------------------------------------------------------------------
# Social Authentication (100% Free Providers)
# Google Cloud OAuth 2.0 Client ID (Free tier, no credit card required)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Apple Sign In (Optional / Free with Apple Developer or Mock in dev)
APPLE_CLIENT_ID=com.lumen.trading.client
APPLE_TEAM_ID=APPLE_TEAM_ID
APPLE_KEY_ID=APPLE_KEY_ID

# -----------------------------------------------------------------------------
# Payment Gateways (100% Free Sandbox & 0% MDR Indian UPI)
# Options: 'sandbox' | 'razorpay' | 'stripe'
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=rzp_test_mock_key
PAYMENT_PROVIDER_SECRET=mock_payment_secret
PAYMENT_WEBHOOK_SECRET=whsec_lumen_enterprise_mock_webhook_secret_2026

# -----------------------------------------------------------------------------
# Binance Exchange Execution Gateway (Free API Keys)
# Options: 'testnet' | 'mainnet'
# Testnet is 100% free with simulated matching engine and live order books
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# AI Market Analysis
# Google Gemini API Key (Free Tier available at aistudio.google.com)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Web3 / EVM Blockchain (100% Free Public RPCs)
# Polygon, Arbitrum, Sepolia public endpoints ($0 cost)
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ==========================================
# PhonePe Payment Gateway
# ==========================================
PAYMENT_PROVIDER=sandbox
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost:3001/api/webhooks/phonepe

# ==========================================
# Frontend OAuth Client IDs (for Vite)
# ==========================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.your-app.client

